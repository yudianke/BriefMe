# 复制本文件为 .env，填入你自己的 key。只需要填 **一个**，程序会自动挑能用的那个。
# .env 已被 .gitignore 排除，不会上传。

# ---------- 中国大陆可直连 ----------
# DEEPSEEK_API_KEY=sk-xxx          # https://platform.deepseek.com
# GLM_API_KEY=xxx                  # 智谱  https://open.bigmodel.cn
# QWEN_API_KEY=sk-xxx              # 通义千问 https://dashscope.console.aliyun.com
# MINIMAX_API_KEY=xxx              # https://platform.minimaxi.com

# ---------- 境外（大陆通常需代理） ----------
# OPENAI_API_KEY=sk-xxx            # ChatGPT
# GEMINI_API_KEY=xxx               # Google Gemini
# XAI_API_KEY=xai-xxx              # Grok
# ANTHROPIC_API_KEY=sk-ant-xxx     # Claude（需 pip install anthropic）
# GROQ_API_KEY=gsk_xxx             # https://console.groq.com （有免费额度）

# ---------- 可选 ----------
# 指定使用顺序（第一个有 key 的作主用，其余作 fallback）
# AI_PROVIDERS=deepseek,qwen
